<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="screen-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.CreateRequestController">
   <content>
      <VBox spacing="12" styleClass="screen">
         <padding>
            <Insets bottom="32" left="24" right="24" top="24" />
         </padding>
         <Button onAction="#handleBack" styleClass="link-button" text="Home" />
         <Label styleClass="title" text="Create relief request" />
         <Label styleClass="field-label" text="Subject" />
         <TextField fx:id="subjectField" promptText="For example: Drinking water for family" />
         <Label styleClass="field-label" text="Details" />
         <TextArea fx:id="detailsArea" prefRowCount="4" promptText="Tell volunteers what you need and how much" wrapText="true" />
         <Label styleClass="field-label" text="Type of help (choose one or more)" />
         <FlowPane fx:id="skillBox" hgap="8" vgap="8" />
         <Label styleClass="field-label" text="Medical needs (optional)" />
         <TextField fx:id="medicalField" promptText="Allergies, medicine, mobility needs" />
         <Label fx:id="errorLabel" managed="false" styleClass="error-label" visible="false" wrapText="true" />
         <Button maxWidth="Infinity" onAction="#handleSubmit" styleClass="primary-button" text="Submit request" />
      </VBox>
   </content>
</ScrollPane>
