<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="screen" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.HomeController">
   <padding>
      <Insets bottom="24" left="24" right="24" top="32" />
   </padding>
   <Label fx:id="greetingLabel" styleClass="title" text="Hello" />
   <Label styleClass="subtitle" text="Let's get your household support." wrapText="true" />
   <Button maxWidth="Infinity" onAction="#handleRequestHelp" styleClass="primary-button" text="Request help" />
   <Label styleClass="section-label" text="Your requests" />
   <ListView fx:id="requestList" onMouseClicked="#handleOpenRequest" VBox.vgrow="ALWAYS" />
   <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="link-button" text="Log out" />
</VBox>
