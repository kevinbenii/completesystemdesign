<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="screen" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.LoginController">
   <padding>
      <Insets bottom="32" left="24" right="24" top="32" />
   </padding>
   <Label styleClass="brand" text="Hurricane Relief" />
   <Label styleClass="title" text="Log in" />
   <Label styleClass="subtitle" text="Request essentials and keep track of help for your family." wrapText="true" />
   <Label styleClass="field-label" text="Username" />
   <TextField fx:id="usernameField" promptText="Username" />
   <Label styleClass="field-label" text="Password" />
   <PasswordField fx:id="passwordField" onAction="#handleLogin" promptText="Password" />
   <Label fx:id="errorLabel" managed="false" styleClass="error-label" visible="false" wrapText="true" />
   <Button maxWidth="Infinity" onAction="#handleLogin" styleClass="primary-button" text="Log in" />
   <Button maxWidth="Infinity" onAction="#handleCreateAccount" styleClass="link-button" text="New here? Create account" />
   <Region VBox.vgrow="ALWAYS" />
   <Label styleClass="footnote" text="In immediate danger? Call 911. Relief requests are not emergency calls." wrapText="true" />
</VBox>
